<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "nvidia-gpu-status">
<!ENTITY author    "xztjhs">
<!ENTITY version   "1.0">
<!ENTITY pkgver    "nvidia-gpu-status-1.0-x86_64-1">
<!ENTITY launch    "Settings/nvidia-gpu-status">
<!ENTITY raw       "https://raw.githubusercontent.com/xztjhs/unraid-NV-status/main">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&raw;/plugin/&name;.plg" launch="&launch;" icon="microchip" min="7.0.0" support="https://github.com/xztjhs/unraid-NV-status/issues">

<CHANGES>
### 1.0
首个正式版。

- 仪表板磁贴：利用率（GPU/显存/编码/解码）、温度、风扇、功耗、显存、频率、
  PCIe 速率与宽度、ECC 计数、行重映射、PCIe replay、编码会话
- GPU 负载 / 温度 / 显存各占一行，用原生进度条样式；字号与行高对齐内置处理器/内存磁贴
- 占用进程表：序号、所属容器/虚拟机、显存、命令行（容器读 cgroup，虚拟机读 qemu guest 名）
- 刷新间隔 0.5–10 秒、显示时长 1–60 分钟，磁贴上即时切换，设置页改默认值
- 历史折线图（GPU/显存/温度）带图例与动态温度量程
- 双通道：nchan 实时推送（&lt;1s），不可用时自动降级为 HTTP 轮询
- 采样器为常驻进程：快层 0.5s 流式（约 1% CPU），慢层 10s 一次
- 中英文界面（按 Unraid 语言设置自动切换）
</CHANGES>

<!-- 1. 停掉旧实例，避免升级时留下孤儿 nvidia-smi -->
<FILE Run="/bin/bash">
<INLINE>
if [ -x /etc/rc.d/rc.&name; ]; then
  bash /etc/rc.d/rc.&name; stop
fi
# 兜底：rc 脚本不在了但进程还活着（手动清过文件、异常升级等）
if [ -f /var/run/&name;.pid ]; then
  OLDPID=$(cat /var/run/&name;.pid 2>/dev/null)
  if [ -n "$OLDPID" ] &amp;&amp; kill -0 "$OLDPID" 2>/dev/null; then
    kill "$OLDPID" 2>/dev/null
    sleep 1
    kill -0 "$OLDPID" 2>/dev/null &amp;&amp; kill -9 "$OLDPID" 2>/dev/null
  fi
  rm -f /var/run/&name;.pid
fi
# 清理可能的孤儿流式进程（按精确模式，避免误伤）
for p in $(pgrep -f 'nvidia-smi --query-gpu=.*-lms' 2>/dev/null); do
  kill "$p" 2>/dev/null
done
exit 0
</INLINE>
</FILE>

<!-- 2. 下载并安装软件包 -->
<FILE Name="&plgPATH;/&pkgver;.txz" Run="upgradepkg --install-new">
<URL>&raw;/archive/&pkgver;.txz</URL>
<MD5>13e9a2927fdf2cd9dcaf7d787012eaec</MD5>
<SHA256>db06961c95045cecc3766260611e9ab971c1c66445b5e23d8cdb27ca21c901c8</SHA256>
</FILE>

<!-- 3. 配置与服务 -->
<FILE Run="/bin/bash">
<INLINE>
set -u
CONFIG="&plgPATH;"
mkdir -p "$CONFIG"

# 升级时保留用户配置；首次安装写入默认值
if [ ! -f "$CONFIG/&name;.cfg" ]; then
  if [ -f "&emhttp;/default.cfg" ]; then
    cp "&emhttp;/default.cfg" "$CONFIG/&name;.cfg"
    echo "created default config: $CONFIG/&name;.cfg"
  fi
else
  echo "keeping existing config: $CONFIG/&name;.cfg"
fi
echo "&version;" > "$CONFIG/version"

# rc 脚本权限（/etc 是内存盘，tar 里的权限会保留，但再兜一次）
[ -f "/etc/rc.d/rc.&name;" ] &amp;&amp; chmod 755 "/etc/rc.d/rc.&name;"

# 清掉旧版本残留的 shm
rm -rf /dev/shm/&name;

# 起服务
bash /etc/rc.d/rc.&name; start

echo ""
echo "-------------------------------------------------------------"
echo " nvidia-gpu-status installed."
echo " Dashboard 上默认显示磁贴；若未看到，点右上角扳手图标 →"
echo " Tile Management → 勾选 \"NVIDIA GPU Status\" → Apply。"
echo " 设置页：Settings → NVIDIA GPU Status"
echo "-------------------------------------------------------------"
exit 0
</INLINE>
</FILE>

<!-- 4. 卸载 -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
if [ -x /etc/rc.d/rc.&name; ]; then
  bash /etc/rc.d/rc.&name; stop
fi
for p in $(pgrep -f 'nvidia-smi --query-gpu=.*-lms' 2>/dev/null); do
  kill "$p" 2>/dev/null
done
removepkg &name; 2>/dev/null
rm -f /etc/rc.d/rc.&name;
rm -rf /dev/shm/&name;
rm -rf "&emhttp;"
rm -rf "&plgPATH;"
exit 0
</INLINE>
</FILE>

</PLUGIN>
