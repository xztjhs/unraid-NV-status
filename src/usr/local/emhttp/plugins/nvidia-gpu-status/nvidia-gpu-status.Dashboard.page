Menu="Dashboard:0"
Icon="microchip"
---
<?php
/* nvidia-gpu-status :: Dashboard 磁贴
 *
 * 只输出一个 <tbody> 到 $mytiles（由 DashStats.page 的 customTiles() 渲染），
 * 以及一段加载 JS 的 <script>。文案由 include/i18n.php 提供，不依赖语言包。
 *
 * ⚠️ 磁贴内不得出现嵌套 <table>/<tbody>：
 *    Unraid 的 addProperties() 会对 div.frame 下每个 tbody 执行 attr('title').md5()，
 *    没有 title 的内层 tbody 会抛异常，导致整页 tile 初始化中断。全部用 div。
 *
 * 字体/间距对齐 dynamix 的 Processor / Interface tile：
 *    行高 2.4rem，label 用 .w26 宽度，数值与条状图用 .usage-disk。
 */
$plugin = 'nvidia-gpu-status';

if (!function_exists('parse_plugin_cfg')) {
  require_once '/usr/local/emhttp/plugins/dynamix/include/Wrappers.php';
}
require_once "/usr/local/emhttp/plugins/$plugin/include/i18n.php";

$nvcfg  = function_exists('parse_plugin_cfg') ? parse_plugin_cfg($plugin) : [];
$column = $nvcfg['COLUMN'] ?? 'column3';
if (!in_array($column, ['column1', 'column2', 'column3'], true)) $column = 'column3';

$enabled = strtolower((string)($nvcfg['ENABLED'] ?? 'yes')) !== 'no';
$hasSmi  = is_executable('/usr/bin/nvidia-smi');

if (!$enabled) return;

$refreshMs = (int)($nvcfg['REFRESH_MS'] ?? 2000);
$windowMin = (int)($nvcfg['WINDOW_MIN'] ?? 5);
$sampleMs  = (int)($nvcfg['SAMPLE_MS'] ?? 500);
$push      = strtolower((string)($nvcfg['PUSH'] ?? 'yes')) !== 'no';

$L = nvgpu_labels();
$h = fn($s) => htmlspecialchars((string)$s, ENT_QUOTES);

/* 未装 nvidia-driver：只放一条提示，不加载 JS */
if (!$hasSmi) {
  $mytiles[$plugin][$column] = '<tbody title="' . $h($L['title']) . ' Status">'
    . '<tr><td>' . $h($L['title']) . '</td></tr>'
    . '<tr><td><div class="nvgpu-missing">' . $h($L['missing']) . '</div></td></tr>'
    . '</tbody>';
  return;
}

$opt = function (array $pairs, $sel) {
  $s = '';
  foreach ($pairs as $v => $label) {
    $s .= '<option value="' . htmlspecialchars((string)$v, ENT_QUOTES) . '"'
        . ((string)$v === (string)$sel ? ' selected' : '') . '>'
        . htmlspecialchars($label, ENT_QUOTES) . '</option>';
  }
  return $s;
};

$refreshOpts = $opt([
  '500' => '0.5s', '1000' => '1s', '2000' => '2s', '3000' => '3s', '5000' => '5s', '10000' => '10s',
], $refreshMs);

$windowOpts = $opt([
  '1' => '1 min', '2' => '2 min', '5' => '5 min', '10' => '10 min', '15' => '15 min',
  '30' => '30 min', '60' => '60 min',
], $windowMin);

$boot = $h(json_encode([
  'api'       => "/plugins/$plugin/api.php",
  'refreshMs' => $refreshMs,
  'windowMin' => $windowMin,
  'sampleMs'  => $sampleMs,
  'push'      => $push,
  'channel'   => 'nvgpu',
  'lang'      => $L,
], JSON_UNESCAPED_UNICODE));

$tileTitle = $h($L['title']) . ' Status';

$mytiles[$plugin][$column] = <<<EOT
<tbody title="{$tileTitle}" id="nvgpu-tile" data-boot="{$boot}">
<tr><td>
  <span class="tile-header">
    <span class="tile-header-left">
      <i class="icon-performance f32"></i>
      <div class="section">
        <h3 class="tile-header-main" id="nvgpu-name">GPU</h3>
        <span class="nvgpu-sub" id="nvgpu-sub">–</span>
      </div>
    </span>
    <span class="tile-header-right">
      <span class="tile-header-right-controls nvgpu-ctl">
        <select id="nvgpu-refresh" class="nvgpu-sel" title="{$h($L['refresh'])}">{$refreshOpts}</select>
        <select id="nvgpu-window" class="nvgpu-sel" title="{$h($L['window'])}">{$windowOpts}</select>
        <i class="fa fa-fw fa-pause control hand" id="nvgpu-pause" title="{$h($L['pause'])}"></i>
        <a href="/Settings/nvidia-gpu-status" title="{$h($L['settings'])}"><i class="fa fa-fw fa-cog control"></i></a>
      </span>
    </span>
  </span>
</td></tr>

<tr><td>
  <div class="nvgpu-kv">
    <span class="nvgpu-k">{$h($L['gpu'])}</span>
    <span class="nvgpu-pct" id="nvgpu-gpu">0%</span>
    <span class="usage-disk"><span id="nvgpu-fill-gpu" class="nvgpu-fill"></span></span>
  </div>
</td></tr>

<tr><td>
  <div class="nvgpu-kv">
    <span class="nvgpu-k">{$h($L['temp'])}</span>
    <span class="nvgpu-pct" id="nvgpu-temp">–</span>
    <span class="usage-disk"><span id="nvgpu-fill-temp" class="nvgpu-fill"></span></span>
  </div>
</td></tr>

<tr><td>
  <div class="nvgpu-kv">
    <span class="nvgpu-k">{$h($L['mem'])}</span>
    <span class="nvgpu-pct" id="nvgpu-mem">–</span>
    <span class="usage-disk"><span id="nvgpu-fill-mem" class="nvgpu-fill"></span></span>
  </div>
</td></tr>

<tr class="nvgpu-chart-row"><td>
  <canvas class="nvgpu-chart" id="nvgpu-chart" height="96"></canvas>
  <div class="nvgpu-legend">
    <span><i class="nvgpu-dot" style="background:#5aa9e6"></i>{$h($L['gpu'])}</span>
    <span><i class="nvgpu-dot" style="background:#8f7ee6"></i>{$h($L['mem'])}</span>
    <span><i class="nvgpu-dot" style="background:#e6805a"></i>{$h($L['temp'])}</span>
  </div>
</td></tr>

<tr><td>
  <div class="nvgpu-kv"><span class="nvgpu-k">{$h($L['fan'])}</span><span class="nvgpu-val" id="nvgpu-fan">–</span></div>
</td></tr>
<tr><td>
  <div class="nvgpu-kv"><span class="nvgpu-k">{$h($L['power'])}</span><span class="nvgpu-val" id="nvgpu-power">–</span></div>
</td></tr>
<tr><td>
  <div class="nvgpu-kv"><span class="nvgpu-k">{$h($L['clocks'])}</span><span class="nvgpu-val" id="nvgpu-clocks">–</span></div>
</td></tr>
<tr><td>
  <div class="nvgpu-kv"><span class="nvgpu-k">{$h($L['pcie'])}</span><span class="nvgpu-val" id="nvgpu-pcie">–</span></div>
</td></tr>
<tr><td>
  <div class="nvgpu-kv"><span class="nvgpu-k">{$h($L['codec'])}</span><span class="nvgpu-val" id="nvgpu-codec">–</span></div>
</td></tr>
<tr><td>
  <div class="nvgpu-kv"><span class="nvgpu-k">{$h($L['ecc'])}</span><span class="nvgpu-val" id="nvgpu-ecc">–</span></div>
</td></tr>

<tr class="nvgpu-proc-head" id="nvgpu-proc-head"><td>{$h($L['processes'])}</td></tr>
<tr class="nvgpu-proc-colhead" id="nvgpu-proc-colhead"><td>
  <span class="nvgpu-pc nvgpu-pc-idx">#</span><span class="nvgpu-pc nvgpu-pc-owner">{$h($L['p_owner'])}</span><span class="nvgpu-pc nvgpu-pc-mem">{$h($L['p_mem'])}</span><span class="nvgpu-pc nvgpu-pc-cmd">{$h($L['p_cmd'])}</span>
</td></tr>
<tr id="nvgpu-proc-rows"><td><div class="nvgpu-proclist" id="nvgpu-procs"><span class="nvgpu-dim">–</span></div></td></tr>

<tr><td>
  <div class="nvgpu-flags" id="nvgpu-flags" style="display:none"></div>
  <span class="nvgpu-foot">
    <span id="nvgpu-age">–</span>
    <span id="nvgpu-mode" class="nvgpu-mode"></span>
  </span>
</td></tr>
</tbody>
EOT;
?>
<script src="/plugins/<?=$plugin?>/javascript/gpu-status.js"></script>
<script>
(function () {
  var tries = 0;
  function go() {
    if (window.NVGPU && typeof window.NVGPU.boot === 'function') {
      window.NVGPU.boot(document.getElementById('nvgpu-name'));
      return true;
    }
    return false;
  }
  $(function () {
    if (go()) return;
    var t = setInterval(function () {
      if (go() || ++tries > 60) clearInterval(t);
    }, 100);
  });
})();
</script>
